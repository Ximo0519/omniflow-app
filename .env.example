# ===== 数据库（必填）=====
# Neon PostgreSQL 连接串，在 https://neon.tech 创建项目后获取
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ===== JWT 认证（必填）=====
# 登录令牌签名密钥，请改为随机长字符串
JWT_SECRET=change-me-to-a-random-long-secret

# ===== DeepSeek 提示词润色（必填）=====
AI_API_KEY=your_deepseek_api_key_here
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ===== Suno 音乐生成（必填）=====
# 第三方 Suno 代理平台 API Key（如 sunoapi.org 等）
SUNO_API_KEY=your_suno_api_key_here
# 代理平台地址（默认 sunoapi.org 协议，更换平台时修改）
SUNO_API_BASE_URL=https://api.sunoapi.org
# Suno 模型版本
SUNO_MODEL=V4

# ===== Cloudflare R2 音频存储（推荐，不配则使用临时音频链接）=====
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aimusic-audio
# 桶的公开访问域名（如 https://pub-xxx.r2.dev）
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ===== 业务配置 =====
# 每用户每日生成额度（次日自动重置）
DAILY_QUOTA=10

# 服务端口
PORT=3000

# ===== Frontend 环境变量 =====
# 后端 API 地址（前后端同源部署时留空）
# VITE_API_URL=https://your-backend-domain.com
