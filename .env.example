# ===== Backend 环境变量 =====
# AI API Key（必填，DeepSeek 在 https://platform.deepseek.com 获取）
AI_API_KEY=your_deepseek_api_key_here

# AI API 基础地址（DeepSeek 默认 https://api.deepseek.com）
AI_API_BASE_URL=https://api.deepseek.com

# 使用的模型名称（deepseek-chat 或 deepseek-reasoner）
AI_MODEL=deepseek-chat

# 服务端口（Vercel 会自动注入，本地开发用）
PORT=3000

# ===== Frontend 环境变量 =====
# 后端 API 地址（纯静态部署时必填，指向你的后端服务地址）
# Vercel 部署时留空即可，前端和后端同源
# VITE_API_URL=https://your-backend-domain.com

# 订阅层级：FREE 显示 Omniflow 角标，其他值不显示
VITE_SUBSCRIPTION_TIER=FREE
